{
  "$schema": "https://folio.mccal.dev/schema/v1/manifest.schema.json",
  "format": 1,
  "id": "com.mccal.folio.theme.classic",
  "name": "Classic theme",
  "version": "1.0.0",
  "author": {
    "name": "Folio",
    "url": "https://github.com/McCal-Codes/folio"
  },
  "minFolio": "0.6.6",
  "section": "themes",
  "kind": [
    "theme"
  ],
  "permissions": [
    "home.appearance",
    "icons"
  ],
  "screens": [
    "cover",
    "inner"
  ],
  "icon": "assets/icons/theme-classic.png",
  "depiction": "depiction.json",
  "license": "MIT",
  "description": "Folio’s standard look: rounded icons, iOS badges and tinted glass.",
  "requires": {
    "features": [
      "theme"
    ]
  }
}
